{
  "name": "@scriptca/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "scriptca build --target wasm --hosts browser",
    "sync:calcium": "node scripts/sync-calcium.mjs",
    "dev": "bun run sync:calcium && bun run build:core && bun --bun vite",
    "build": "bun run sync:calcium && bun run build:core && bun --bun vite build && node scripts/postbuild.mjs",
    "verify": "bun run build && bun scripts/assert-dist.mjs",
    "typecheck": "bun run sync:calcium && tsc --noEmit"
  },
  "dependencies": {
    "@unikit-bridge/scriptca": "workspace:*",
    "@unikit-bridge/ui": "^0.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@scriptc/runtime-wasm32-wasi": "^0.4.16",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "scriptc": "^0.4.16",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
